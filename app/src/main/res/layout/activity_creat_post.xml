<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".Activity.CreatPostActivity">

    <!-- Ảnh đại diện người dùng -->
    <ImageView
        android:id="@+id/imageUserCreatePost"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/placeholder" />

    <!-- Tên người dùng -->
    <TextView
        android:id="@+id/tvNameUserCreatePost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Tên người dùng"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/imageUserCreatePost"
        app:layout_constraintTop_toTopOf="@id/imageUserCreatePost" />

    <!-- Ô nhập nội dung bài viết -->
    <EditText
        android:id="@+id/edtCreatePost"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:maxHeight="500dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        android:background="@android:color/transparent"
        android:gravity="top"
        android:paddingLeft="@dimen/size10dp"
        android:hint="Bạn đang nghĩ gì?"
        android:textColor="@color/black"
        android:inputType="textMultiLine"
        android:maxLines="10"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/imageUserCreatePost"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ảnh hiển thị sau khi người dùng chọn -->
    <ImageView
        android:id="@+id/imageCreatePost"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:background="@drawable/placeholder"
        android:contentDescription="Ảnh bài đăng"
        app:layout_constraintTop_toBottomOf="@id/edtCreatePost"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Thanh dưới chứa nút ảnh và gửi -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:gravity="center_vertical|center_horizontal"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Nút chọn ảnh -->
        <ImageView
            android:id="@+id/imageChose"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:contentDescription="Chọn ảnh"
            app:srcCompat="@drawable/picture" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Nút gửi bài -->
        <ImageView
            android:id="@+id/imageSentCreatePost"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Gửi bài viết"
            app:srcCompat="@drawable/sent1" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
